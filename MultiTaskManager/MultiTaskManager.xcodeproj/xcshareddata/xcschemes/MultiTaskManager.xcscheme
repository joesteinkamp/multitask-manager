      <!-- OS_ACTIVITY_MODE=disable silences os_log output from system
           frameworks in the Xcode console. It is not hiding anything of ours:
           the noise it removes is macOS repeatedly failing to register this app
           with the App Intents framework (com.apple.linkd.autoShortcut, error
           4097) and CFPreferences reporting a null AppleLocale — both normal for
           a development-signed LSUIElement agent, and neither reachable from
           our code. Print statements and our own logging are unaffected.
           Remove this if you ever need to read a system framework's own log. -->
      <EnvironmentVariables>
         <EnvironmentVariable
            key = "OS_ACTIVITY_MODE"
            value = "disable"
            isEnabled = "YES">
         </EnvironmentVariable>
      </EnvironmentVariables>
   </LaunchAction>
